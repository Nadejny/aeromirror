+ * A matching frame must then pass each stage in order: accepted appsrc push,
+ * decoded sink-pad buffer with the exact fresh input PTS, and D3D11 Present.
+ * The Present callback runs under the D3D11 device lock, so it only publishes
+ * an atomic flag; the GLib main-loop timer writes the diagnostic marker. */
+static volatile gint aeromirror_recovery_epoch = 0;
+static volatile gint aeromirror_recovery_gap_seconds = 0;
+static volatile gint aeromirror_recovery_push_accepted_epoch = 0;
+static volatile gint aeromirror_recovery_sink_epoch = 0;
+static volatile gint aeromirror_recovery_present_seen_epoch = 0;
+static volatile gint aeromirror_recovery_present_pending_epoch = 0;
+static volatile gint aeromirror_recovery_push_logged_epoch = 0;
