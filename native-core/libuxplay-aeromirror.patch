+static gboolean aeromirror_owner_ready(gpointer data) {
+    (void) data;
+    if (do_shutdown.load()) return G_SOURCE_REMOVE;
+    aeromirror_discovery_capability_announced.store(true);
+    aeromirror_protocol_marker(
+        "AEROMIRROR_DISCOVERY_REFRESH_CAPABILITY version=1");
+    if (aeromirror_discovery_request.load()) {
+        GMainContext *context = NULL;
+        {
+            std::lock_guard<std::mutex> guard(aeromirror_context_mutex);
+            if (aeromirror_main_context)
+                context = g_main_context_ref(aeromirror_main_context);
+        }
+        if (context) {
+            aeromirror_attach_discovery_request(context);
+            g_main_context_unref(context);
+        }
+    }
+    if (!aeromirror_dnssd_watch_id && dnssd) {
+        int initial_error = 0;
+        if (dnssd_get_registration_status(
+                dnssd, &initial_error, NULL) < 0) {
+            aeromirror_schedule_dnssd_retry();
+        }
+    }
+    return G_SOURCE_REMOVE;
+}
+
+int request_discovery_refresh(unsigned long long request_id) {
+    if (!request_id || do_shutdown.load() ||
+        !aeromirror_discovery_capability_announced.load()) return 0;
+    uint64_t empty = 0;
+    if (!aeromirror_discovery_request.compare_exchange_strong(
+            empty, (uint64_t) request_id)) {
+        return empty == request_id ? 1 : 0;
+    }
+    GMainContext *context = NULL;
+    {
+        std::lock_guard<std::mutex> guard(aeromirror_context_mutex);
+        if (aeromirror_main_context) {
+            context = g_main_context_ref(aeromirror_main_context);
+        }
+    }
+    if (context) {
+        aeromirror_attach_discovery_request(context);
+        g_main_context_unref(context);
+    }
+    // A command admitted after capability announcement survives a transient
+    // video/GLib-loop reset.  The next owner-ready callback attaches it to the
+    // new owning iteration without restarting listeners or the process.
+    return 1;
+}
+
+static void aeromirror_attach_discovery_request(GMainContext *context) {
+    if (!context) return;
+    GSource *source = g_idle_source_new();
+    g_source_set_callback(
+        source, aeromirror_refresh_discovery_on_owner, NULL, NULL);
+    g_source_attach(source, context);
+    g_source_unref(source);
+}
+
+static void aeromirror_emit_discovery_failed(uint64_t request_id,
+                                             uint64_t generation,
+                                             int error) {
+    aeromirror_protocol_marker(
+         "AEROMIRROR_DISCOVERY_REFRESH_FAILED request=%" PRIu64
+         " generation=%" PRIu64 " error=%d pid=%lu raop_port=%u airplay_port=%u",
+         request_id, generation, error, aeromirror_process_id(),
+         raop_port, airplay_port);
+}
+
+static void aeromirror_schedule_dnssd_retry() {
+    static const unsigned int delays[] = {1, 2, 5, 10, 30};
+    if (do_shutdown.load() || aeromirror_dnssd_retry_id) {
+        return;
+    }
+    unsigned int index = std::min<unsigned int>(
+        aeromirror_dnssd_retry_attempt,
+        (sizeof(delays) / sizeof(delays[0])) - 1);
+    aeromirror_dnssd_retry_attempt++;
+    aeromirror_dnssd_retry_id = g_timeout_add_seconds(
+        delays[index], aeromirror_retry_discovery_on_owner, NULL);
+    LOGI("AEROMIRROR_DISCOVERY_RETRY_SCHEDULED attempt=%u delay_seconds=%u",
+         aeromirror_dnssd_retry_attempt, delays[index]);
+}
+
+static gboolean aeromirror_dnssd_watch(gpointer data) {
+    (void) data;
+    if (!dnssd || do_shutdown.load()) {
+        aeromirror_dnssd_watch_id = 0;
+        return G_SOURCE_REMOVE;
+    }
+    int process_error = dnssd_process_results(dnssd);
+    int registration_error = 0;
+    uint64_t generation = 0;
+    int status = dnssd_get_registration_status(
+        dnssd, &registration_error, &generation);
+    if (process_error || status < 0) {
+        uint64_t request_id = aeromirror_discovery_generation_request;
+        aeromirror_emit_discovery_failed(
+            request_id, generation,
+            registration_error ? registration_error : process_error);
+        aeromirror_dnssd_watch_id = 0;
+        dnssd_unregister_services(dnssd);
+        aeromirror_dnssd_waiting = false;
+        aeromirror_protocol_marker("AEROMIRROR_DNSSD_DEGRADED");
+        aeromirror_schedule_dnssd_retry();
+        return G_SOURCE_REMOVE;
+    }
+    if (aeromirror_dnssd_waiting && status == 0 &&
+        g_get_monotonic_time() >= aeromirror_dnssd_deadline) {
+        uint64_t request_id = aeromirror_discovery_generation_request;
+        aeromirror_emit_discovery_failed(
+            request_id, generation, -65568);
+        aeromirror_dnssd_watch_id = 0;
+        dnssd_unregister_services(dnssd);
+        aeromirror_dnssd_waiting = false;
+        aeromirror_protocol_marker("AEROMIRROR_DNSSD_DEGRADED");
+        aeromirror_schedule_dnssd_retry();
+        return G_SOURCE_REMOVE;
+    }
+    if (status > 0 && aeromirror_dnssd_ready_generation != generation) {
+        aeromirror_protocol_marker(
+             "AEROMIRROR_DISCOVERY_REFRESH_READY request=%" PRIu64
+             " generation=%" PRIu64 " pid=%lu raop_port=%u airplay_port=%u",
+             aeromirror_discovery_generation_request, generation,
+             aeromirror_process_id(), raop_port, airplay_port);
+        aeromirror_protocol_marker("AEROMIRROR_DNSSD_READY");
+        aeromirror_dnssd_waiting = false;
+        aeromirror_dnssd_ready_generation = generation;
+        aeromirror_dnssd_retry_attempt = 0;
+        aeromirror_discovery_generation_request = 0;
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+static gboolean aeromirror_retry_discovery_on_owner(gpointer data) {
+    (void) data;
+    aeromirror_dnssd_retry_id = 0;
+    if (do_shutdown.load() || !dnssd)
+        return G_SOURCE_REMOVE;
+    if (open_connections.load()) {
+        aeromirror_schedule_dnssd_retry();
+        return G_SOURCE_REMOVE;
+    }
+    aeromirror_begin_dnssd_generation(0);
+    return G_SOURCE_REMOVE;
+}
+
+static int aeromirror_begin_dnssd_generation(uint64_t request_id) {
+    if (request_id && aeromirror_dnssd_retry_id) {
+        g_source_remove(aeromirror_dnssd_retry_id);
+        aeromirror_dnssd_retry_id = 0;
+    }
+    aeromirror_discovery_generation++;
+    if (!aeromirror_discovery_generation) aeromirror_discovery_generation++;
+    aeromirror_discovery_generation_request = request_id;
+    if (request_id)
+        aeromirror_discovery_highest_request = request_id;
+    aeromirror_dnssd_waiting = true;
+    aeromirror_dnssd_deadline = g_get_monotonic_time() + 5000000;
+    int error = dnssd_register_services(
+        dnssd, raop_port, airplay_port, aeromirror_discovery_generation);
+    if (error) {
+        aeromirror_dnssd_waiting = false;
+        aeromirror_emit_discovery_failed(
+            request_id, aeromirror_discovery_generation, error);
+        aeromirror_protocol_marker("AEROMIRROR_DNSSD_DEGRADED");
+        dnssd_unregister_services(dnssd);
+        aeromirror_discovery_generation_request = 0;
+        aeromirror_schedule_dnssd_retry();
+        return error;
+    }
+    if (!aeromirror_dnssd_watch_id)
+        aeromirror_dnssd_watch_id = g_timeout_add(
+            100, aeromirror_dnssd_watch, NULL);
     return 0;
 }
 
+static gboolean aeromirror_refresh_discovery_on_owner(gpointer data) {
+    (void) data;
+    uint64_t request_id = aeromirror_discovery_request.exchange(0);
+    if (!request_id || do_shutdown.load() || !dnssd)
+        return G_SOURCE_REMOVE;
+    if (request_id <= aeromirror_discovery_highest_request) {
+        aeromirror_protocol_marker(
+             "AEROMIRROR_DISCOVERY_REFRESH_DUPLICATE request=%" PRIu64,
+             request_id);
+        return G_SOURCE_REMOVE;
+    }
+    if (open_connections.load() || aeromirror_dnssd_waiting) {
+        aeromirror_discovery_deferred_request = std::max(
+            aeromirror_discovery_deferred_request, request_id);
+        if (!aeromirror_discovery_deferred_id) {
+            aeromirror_discovery_deferred_id = g_timeout_add(
+                500, aeromirror_deferred_discovery_on_owner, NULL);
+        }
+        aeromirror_protocol_marker(
+             "AEROMIRROR_DISCOVERY_REFRESH_DEFERRED request=%" PRIu64
+             " reason=%s pid=%lu raop_port=%u airplay_port=%u",
+             request_id,
+             open_connections.load() ? "client-active" : "refresh-pending",
+             aeromirror_process_id(), raop_port, airplay_port);
+        return G_SOURCE_REMOVE;
+    }
+    aeromirror_protocol_marker(
+         "AEROMIRROR_DISCOVERY_REFRESH_ACCEPTED request=%" PRIu64
+         " next_generation=%" PRIu64 " pid=%lu raop_port=%u airplay_port=%u",
+         request_id, aeromirror_discovery_generation + 1,
+         aeromirror_process_id(), raop_port, airplay_port);
+    aeromirror_begin_dnssd_generation(request_id);
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean aeromirror_deferred_discovery_on_owner(gpointer data) {
+    (void) data;
+    if (do_shutdown.load() || !dnssd) {
+        aeromirror_discovery_deferred_id = 0;
+        aeromirror_discovery_deferred_request = 0;
+        return G_SOURCE_REMOVE;
+    }
+    if (open_connections.load() || aeromirror_dnssd_waiting)
+        return G_SOURCE_CONTINUE;
+    uint64_t request_id = aeromirror_discovery_deferred_request;
+    aeromirror_discovery_deferred_request = 0;
+    aeromirror_discovery_deferred_id = 0;
+    if (!request_id || request_id <= aeromirror_discovery_highest_request)
+        return G_SOURCE_REMOVE;
+    aeromirror_protocol_marker(
+         "AEROMIRROR_DISCOVERY_REFRESH_ACCEPTED request=%" PRIu64
+         " next_generation=%" PRIu64 " pid=%lu raop_port=%u airplay_port=%u",
+         request_id, aeromirror_discovery_generation + 1,
+         aeromirror_process_id(), raop_port, airplay_port);
+    aeromirror_begin_dnssd_generation(request_id);
+    return G_SOURCE_REMOVE;
+}
