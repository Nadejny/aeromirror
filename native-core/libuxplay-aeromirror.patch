+static void aeromirror_attach_d3d11_present_proof(
+        video_renderer_t *selected, GstElement *videosink_element) {
+    if (!sync) {
+        return;
+    }
+    GstElementFactory *factory = gst_element_get_factory(videosink_element);
+    const gchar *factory_name = factory
+        ? gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory)) : NULL;
+    if (!factory_name || strcmp(factory_name, "d3d11videosink") ||
+        !g_signal_lookup("present", G_OBJECT_TYPE(videosink_element)) ||
+        !g_object_class_find_property(
+            G_OBJECT_GET_CLASS(videosink_element), "emit-present")) {
+        return;
+    }
+    GstPad *sink_pad = gst_element_get_static_pad(videosink_element, "sink");
+    if (!sink_pad) {
+        return;
+    }
+    g_object_set(videosink_element, "emit-present", TRUE, NULL);
+    selected->aeromirror_present_sink =
+        GST_ELEMENT(gst_object_ref(videosink_element));
+    selected->aeromirror_present_pad = sink_pad;
+    selected->aeromirror_present_handler = g_signal_connect(
+        videosink_element, "present",
+        G_CALLBACK(aeromirror_recovery_present),
+        GINT_TO_POINTER(selected->id + 1));
+    selected->aeromirror_sink_probe = gst_pad_add_probe(
