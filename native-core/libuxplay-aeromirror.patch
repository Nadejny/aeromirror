+int
+dnssd_process_results(dnssd_t *dnssd)
+{
+    if (!dnssd) return -1;
+    DNSServiceRef refs[2] = {dnssd->raop_service, dnssd->airplay_service};
+    for (int i = 0; i < 2; i++) {
+        if (!refs[i]) continue;
+        dnssd_socket_t socket_fd = dnssd->DNSServiceRefSockFD(refs[i]);
+#ifdef _WIN32
+        if (socket_fd == INVALID_SOCKET) {
+#else
+        if (socket_fd < 0) {
+#endif
+            dnssd->registration_error = -1;
+            return -1;
+        }
+
+        fd_set readable;
+        struct timeval timeout = {0, 0};
+        FD_ZERO(&readable);
+        FD_SET(socket_fd, &readable);
+#ifdef _WIN32
+        int ready = select(0, &readable, NULL, NULL, &timeout);
+#else
