+/* The feedback callback arms an epoch only after it has logged HTTP recovery.
+ * A matching frame must then pass each stage in order: accepted appsrc push,
+ * decoded sink-pad buffer with the exact fresh input PTS, and D3D11 Present.
+ * The Present callback runs under the D3D11 device lock, so it only publishes
+ * an atomic flag; the GLib main-loop timer writes the diagnostic marker. */
+static volatile gint aeromirror_recovery_epoch = 0;
+static volatile gint aeromirror_recovery_gap_seconds = 0;
+static volatile gint aeromirror_recovery_push_accepted_epoch = 0;
+static volatile gint aeromirror_recovery_sink_epoch = 0;
+static volatile gint aeromirror_recovery_present_seen_epoch = 0;
+static volatile gint aeromirror_recovery_present_pending_epoch = 0;
+static volatile gint aeromirror_recovery_push_logged_epoch = 0;
+static volatile gint aeromirror_recovery_push_failure_logged_epoch = 0;
+static volatile gint aeromirror_active_renderer_id = 0;
+static volatile gint aeromirror_active_present_proof_ready = 0;
+static GMutex aeromirror_recovery_metadata_lock;
+typedef struct {
+    GstClockTime pts;
+    gint epoch;
+    gint pts_delta_ms;
+    gboolean accepted;
+} aeromirror_recovery_pts_candidate_t;
+static aeromirror_recovery_pts_candidate_t
+    aeromirror_recovery_pts[AEROMIRROR_RECOVERY_PTS_SLOTS];
+static guint aeromirror_recovery_pts_next = 0;
+static gint aeromirror_recovery_matched_slot = -1;
+static GstClockTime aeromirror_recovery_matched_pts = GST_CLOCK_TIME_NONE;
+static gint aeromirror_recovery_pts_delta_ms = 0;
+
+static void aeromirror_reset_recovery_candidates_locked() {
+    g_atomic_int_set(&aeromirror_recovery_push_accepted_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_sink_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_present_seen_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_present_pending_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_push_logged_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_push_failure_logged_epoch, 0);
+    memset(aeromirror_recovery_pts, 0,
+           sizeof(aeromirror_recovery_pts));
+    aeromirror_recovery_pts_next = 0;
+    aeromirror_recovery_matched_slot = -1;
+    aeromirror_recovery_matched_pts = GST_CLOCK_TIME_NONE;
+    aeromirror_recovery_pts_delta_ms = 0;
+}
+
+static void aeromirror_reset_recovery_candidates() {
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    aeromirror_reset_recovery_candidates_locked();
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+}
+
+static gint aeromirror_signed_delta_ms(GstClockTime pts,
+                                       GstClockTime running_time) {
+    guint64 delta_ns;
+    guint64 delta_ms;
+    if (pts >= running_time) {
+        delta_ns = pts - running_time;
+        delta_ms = delta_ns / GST_MSECOND;
+        return delta_ms > G_MAXINT ? G_MAXINT : (gint) delta_ms;
+    }
+    delta_ns = running_time - pts;
+    delta_ms = delta_ns / GST_MSECOND;
+    return delta_ms > G_MAXINT ? G_MININT : -(gint) delta_ms;
+}
+
+void video_renderer_arm_recovery(unsigned int epoch,
+                                 unsigned int gap_seconds) {
+    if (!epoch || epoch > G_MAXINT) {
+        return;
+    }
+    /* Disarm the previous challenge before clearing any stage. This prevents
+     * a late sink/Present callback from repopulating an old epoch while the
+     * new challenge is being published. */
+    g_atomic_int_set(&aeromirror_recovery_epoch, 0);
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    aeromirror_reset_recovery_candidates_locked();
+    g_atomic_int_set(&aeromirror_recovery_gap_seconds,
+                     (gint) MIN(gap_seconds, (unsigned int) G_MAXINT));
+    g_atomic_int_set(&aeromirror_recovery_epoch, (gint) epoch);
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+}
+
+void video_renderer_cancel_recovery() {
+    g_atomic_int_set(&aeromirror_recovery_epoch, 0);
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    aeromirror_reset_recovery_candidates_locked();
+    g_atomic_int_set(&aeromirror_recovery_gap_seconds, 0);
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+}
+
+static GstPadProbeReturn aeromirror_recovery_sink_probe(
+        GstPad *pad, GstPadProbeInfo *info, gpointer user_data) {
+    gint selected_id = GPOINTER_TO_INT(user_data);
+    gint epoch = g_atomic_int_get(&aeromirror_recovery_epoch);
+    if (!epoch || selected_id <= 0 ||
+        g_atomic_int_get(&aeromirror_active_renderer_id) != selected_id ||
+        !(GST_PAD_PROBE_INFO_TYPE(info) & GST_PAD_PROBE_TYPE_BUFFER)) {
+        return GST_PAD_PROBE_OK;
+    }
+    GstBuffer *buffer = GST_PAD_PROBE_INFO_BUFFER(info);
+    GstClockTime sink_pts = buffer ? GST_BUFFER_PTS(buffer) : GST_CLOCK_TIME_NONE;
+    gint matched_slot = -1;
+    gboolean accepted = FALSE;
+    gint pts_delta_ms = 0;
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    if (g_atomic_int_get(&aeromirror_recovery_epoch) == epoch &&
+        aeromirror_recovery_matched_slot < 0) {
+        for (guint i = 0; i < AEROMIRROR_RECOVERY_PTS_SLOTS; i++) {
+            if (aeromirror_recovery_pts[i].epoch == epoch &&
+                aeromirror_recovery_pts[i].pts == sink_pts) {
+                matched_slot = (gint) i;
+                accepted = aeromirror_recovery_pts[i].accepted;
+                pts_delta_ms =
+                    aeromirror_recovery_pts[i].pts_delta_ms;
+                aeromirror_recovery_matched_slot = matched_slot;
+                aeromirror_recovery_matched_pts = sink_pts;
+                aeromirror_recovery_pts_delta_ms = pts_delta_ms;
+                break;
+            }
+        }
+    }
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+    if (!GST_CLOCK_TIME_IS_VALID(sink_pts) || matched_slot < 0) {
+        return GST_PAD_PROBE_OK;
+    }
+    if (g_atomic_int_compare_and_exchange(
+            &aeromirror_recovery_sink_epoch, 0, epoch)) {
+        logger_log(logger, LOGGER_INFO,
+                   "AEROMIRROR_VIDEO_SINK_RECOVERED epoch=%d "
+                   "target_pts_ns=%" G_GUINT64_FORMAT " sink_pts_ns=%" G_GUINT64_FORMAT,
+                   epoch, sink_pts, sink_pts);
+    }
+    if (accepted) {
+        g_atomic_int_set(
+            &aeromirror_recovery_push_accepted_epoch, epoch);
+    }
+    return GST_PAD_PROBE_OK;
+}
+
+static void aeromirror_recovery_present(GstElement *videosink,
+                                        GstObject *device,
+                                        gpointer render_target,
+                                        gpointer user_data) {
+    gint selected_id = GPOINTER_TO_INT(user_data);
+    gint epoch = g_atomic_int_get(&aeromirror_recovery_epoch);
+    (void) videosink;
+    (void) device;
+    (void) render_target;
+    if (!epoch || selected_id <= 0 ||
+        g_atomic_int_get(&aeromirror_active_renderer_id) != selected_id ||
+        g_atomic_int_get(&aeromirror_recovery_sink_epoch) != epoch) {
+        return;
+    }
+    g_atomic_int_compare_and_exchange(
+        &aeromirror_recovery_present_seen_epoch, 0, epoch);
+    if (g_atomic_int_get(
+            &aeromirror_recovery_push_accepted_epoch) == epoch) {
+        g_atomic_int_compare_and_exchange(
+            &aeromirror_recovery_present_pending_epoch, 0, epoch);
+    }
+}
+
+void video_renderer_poll_recovery_present() {
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    gint epoch = g_atomic_int_get(
+        &aeromirror_recovery_present_pending_epoch);
+    if (!epoch || !g_atomic_int_compare_and_exchange(
+            &aeromirror_recovery_epoch, epoch, 0)) {
+        g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+        return;
+    }
+    gint gap_seconds = g_atomic_int_get(
+        &aeromirror_recovery_gap_seconds);
+    gint pts_delta_ms = aeromirror_recovery_pts_delta_ms;
+    aeromirror_reset_recovery_candidates_locked();
+    g_atomic_int_set(&aeromirror_recovery_gap_seconds, 0);
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+    logger_log(logger, LOGGER_INFO,
+               "AEROMIRROR_VIDEO_PRESENT_READY epoch=%d gap_seconds=%d "
+               "proof=d3d11-present pts_delta_ms=%d",
+               epoch, gap_seconds, pts_delta_ms);
+}
+
+static void aeromirror_attach_d3d11_present_proof(
+        video_renderer_t *selected, GstElement *videosink_element) {
+    if (!sync) {
+        return;
+    }
+    GstElementFactory *factory = gst_element_get_factory(videosink_element);
+    const gchar *factory_name = factory
+        ? gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory)) : NULL;
+    if (!factory_name || strcmp(factory_name, "d3d11videosink") ||
+        !g_signal_lookup("present", G_OBJECT_TYPE(videosink_element)) ||
+        !g_object_class_find_property(
+            G_OBJECT_GET_CLASS(videosink_element), "emit-present")) {
+        return;
+    }
+    GstPad *sink_pad = gst_element_get_static_pad(videosink_element, "sink");
+    if (!sink_pad) {
+        return;
+    }
+    g_object_set(videosink_element, "emit-present", TRUE, NULL);
+    selected->aeromirror_present_sink =
+        GST_ELEMENT(gst_object_ref(videosink_element));
+    selected->aeromirror_present_pad = sink_pad;
+    selected->aeromirror_present_handler = g_signal_connect(
+        videosink_element, "present",
+        G_CALLBACK(aeromirror_recovery_present),
+        GINT_TO_POINTER(selected->id + 1));
+    selected->aeromirror_sink_probe = gst_pad_add_probe(
+        sink_pad, GST_PAD_PROBE_TYPE_BUFFER,
+        aeromirror_recovery_sink_probe,
+        GINT_TO_POINTER(selected->id + 1), NULL);
+    selected->aeromirror_present_proof_ready =
+        selected->aeromirror_present_handler != 0 &&
+        selected->aeromirror_sink_probe != 0;
+    if (!selected->aeromirror_present_proof_ready) {
+        if (selected->aeromirror_present_handler) {
+            g_signal_handler_disconnect(
+                selected->aeromirror_present_sink,
+                selected->aeromirror_present_handler);
+        }
+        if (selected->aeromirror_sink_probe) {
+            gst_pad_remove_probe(
+                selected->aeromirror_present_pad,
+                selected->aeromirror_sink_probe);
+        }
+        gst_object_unref(selected->aeromirror_present_pad);
+        gst_object_unref(selected->aeromirror_present_sink);
+        selected->aeromirror_present_pad = NULL;
+        selected->aeromirror_present_sink = NULL;
+        selected->aeromirror_present_handler = 0;
+        selected->aeromirror_sink_probe = 0;
+        return;
+    }
+    logger_log(logger, LOGGER_INFO,
+               "AEROMIRROR_VIDEO_PRESENT_PROOF_READY codec=%s "
+               "videosink=d3d11videosink",
+               selected->codec);
+}
+
+static void aeromirror_detach_d3d11_present_proof(
+        video_renderer_t *selected) {
+    if (!selected) {
+        return;
+    }
+    selected->aeromirror_present_proof_ready = false;
+    if (selected->aeromirror_present_handler &&
+        selected->aeromirror_present_sink) {
+        g_signal_handler_disconnect(
+            selected->aeromirror_present_sink,
+            selected->aeromirror_present_handler);
+    }
+    if (selected->aeromirror_sink_probe &&
+        selected->aeromirror_present_pad) {
+        gst_pad_remove_probe(
+            selected->aeromirror_present_pad,
+            selected->aeromirror_sink_probe);
+    }
+    if (selected->aeromirror_present_pad) {
+        gst_object_unref(selected->aeromirror_present_pad);
+    }
+    if (selected->aeromirror_present_sink) {
+        gst_object_unref(selected->aeromirror_present_sink);
+    }
+    selected->aeromirror_present_pad = NULL;
+    selected->aeromirror_present_sink = NULL;
+    selected->aeromirror_present_handler = 0;
+    selected->aeromirror_sink_probe = 0;
+}
+
+bool video_renderer_present_proof_available() {
+    return g_atomic_int_get(
+        &aeromirror_active_present_proof_ready) == 1;
+}
+
+static void aeromirror_log_pipeline_selection(video_renderer_t *selected) {
+    if (!selected || selected->aeromirror_selection_logged || hls_video ||
+        !strcmp(selected->codec, jpeg)) {
+        return;
+    }
+
+    char decoder_name[64] = { 0 };
+    char videosink_name[64] = { 0 };
+    GstIterator *iterator = gst_bin_iterate_recurse(GST_BIN(selected->pipeline));
+    GValue item = G_VALUE_INIT;
+    gboolean done = FALSE;
+
+    while (!done) {
+        switch (gst_iterator_next(iterator, &item)) {
+        case GST_ITERATOR_OK: {
+            GstElement *element = GST_ELEMENT(g_value_get_object(&item));
+            GstElementFactory *factory = gst_element_get_factory(element);
+            if (factory) {
+                const gchar *factory_name = gst_plugin_feature_get_name(
+                    GST_PLUGIN_FEATURE(factory));
+                const gchar *klass = gst_element_factory_get_metadata(
+                    factory, GST_ELEMENT_METADATA_KLASS);
+                if (factory_name && klass) {
+                    if (!decoder_name[0] && strstr(klass, "Decoder") &&
+                        strstr(klass, "Video") &&
+                        strcmp(factory_name, "decodebin")) {
+                        g_strlcpy(decoder_name, factory_name, sizeof(decoder_name));
+                    }
+                    if (!videosink_name[0] && strstr(klass, "Sink") &&
+                        strstr(klass, "Video") &&
+                        strcmp(factory_name, "autovideosink")) {
+                        g_strlcpy(videosink_name, factory_name, sizeof(videosink_name));
+                    }
+                }
+            }
+            g_value_reset(&item);
+            break;
+        }
+        case GST_ITERATOR_RESYNC:
+            gst_iterator_resync(iterator);
+            decoder_name[0] = '\0';
+            videosink_name[0] = '\0';
+            break;
+        case GST_ITERATOR_ERROR:
+        case GST_ITERATOR_DONE:
+            done = TRUE;
+            break;
+        }
+    }
+    if (G_VALUE_TYPE(&item)) {
+        g_value_unset(&item);
+    }
+    gst_iterator_free(iterator);
+
+    if (decoder_name[0] && videosink_name[0]) {
+        logger_log(logger, LOGGER_INFO,
+                   "AEROMIRROR_GSTREAMER_SELECTED codec=%s decoder=%s videosink=%s",
+                   selected->codec, decoder_name, videosink_name);
+        selected->aeromirror_selection_logged = true;
+    }
+}
