+static void aeromirror_recovery_present(GstElement *videosink,
+                                        GstObject *device,
+                                        gpointer render_target,
+                                        gpointer user_data) {
+    gint selected_id = GPOINTER_TO_INT(user_data);
+    gint epoch = g_atomic_int_get(&aeromirror_recovery_epoch);
+    (void) videosink;
+    (void) device;
+    (void) render_target;
+    if (!epoch || selected_id <= 0 ||
+        g_atomic_int_get(&aeromirror_active_renderer_id) != selected_id ||
+        g_atomic_int_get(&aeromirror_recovery_sink_epoch) != epoch) {
+        return;
+    }
+    g_atomic_int_compare_and_exchange(
+        &aeromirror_recovery_present_seen_epoch, 0, epoch);
+    if (g_atomic_int_get(
+            &aeromirror_recovery_push_accepted_epoch) == epoch) {
+        g_atomic_int_compare_and_exchange(
+            &aeromirror_recovery_present_pending_epoch, 0, epoch);
+    }
