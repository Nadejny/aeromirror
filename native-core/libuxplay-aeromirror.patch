+static void aeromirror_log_pipeline_selection(video_renderer_t *selected) {
+    if (!selected || selected->aeromirror_selection_logged || hls_video ||
+        !strcmp(selected->codec, jpeg)) {
+        return;
+    }
+
+    char decoder_name[64] = { 0 };
+    char videosink_name[64] = { 0 };
+    GstIterator *iterator = gst_bin_iterate_recurse(GST_BIN(selected->pipeline));
+    GValue item = G_VALUE_INIT;
+    gboolean done = FALSE;
+
+    while (!done) {
+        switch (gst_iterator_next(iterator, &item)) {
+        case GST_ITERATOR_OK: {
+            GstElement *element = GST_ELEMENT(g_value_get_object(&item));
+            GstElementFactory *factory = gst_element_get_factory(element);
+            if (factory) {
+                const gchar *factory_name = gst_plugin_feature_get_name(
+                    GST_PLUGIN_FEATURE(factory));
+                const gchar *klass = gst_element_factory_get_metadata(
+                    factory, GST_ELEMENT_METADATA_KLASS);
+                if (factory_name && klass) {
+                    if (!decoder_name[0] && strstr(klass, "Decoder") &&
+                        strstr(klass, "Video") &&
+                        strcmp(factory_name, "decodebin")) {
+                        g_strlcpy(decoder_name, factory_name, sizeof(decoder_name));
+                    }
+                    if (!videosink_name[0] && strstr(klass, "Sink") &&
+                        strstr(klass, "Video") &&
+                        strcmp(factory_name, "autovideosink")) {
+                        g_strlcpy(videosink_name, factory_name, sizeof(videosink_name));
+                    }
+                }
+            }
+            g_value_reset(&item);
+            break;
+        }
+        case GST_ITERATOR_RESYNC:
+            gst_iterator_resync(iterator);
+            decoder_name[0] = '\0';
+            videosink_name[0] = '\0';
+            break;
+        case GST_ITERATOR_ERROR:
+        case GST_ITERATOR_DONE:
+            done = TRUE;
+            break;
+        }
+    }
+    if (G_VALUE_TYPE(&item)) {
+        g_value_unset(&item);
+    }
+    gst_iterator_free(iterator);
+
+    if (decoder_name[0] && videosink_name[0]) {
+        logger_log(logger, LOGGER_INFO,
+                   "AEROMIRROR_GSTREAMER_SELECTED codec=%s decoder=%s videosink=%s",
+                   selected->codec, decoder_name, videosink_name);
+        selected->aeromirror_selection_logged = true;
+    }
+}
