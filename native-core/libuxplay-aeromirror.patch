+void
+dnssd_unregister_services(dnssd_t *dnssd)
+{
+    if (!dnssd) return;
+    dnssd_unregister_raop(dnssd);
+    dnssd_unregister_airplay(dnssd);
+}
+
+int
+dnssd_register_services(dnssd_t *dnssd, unsigned short raop_port,
+                        unsigned short airplay_port, uint64_t generation)
+{
+    if (!dnssd || !generation) return -1;
+
+    dnssd_unregister_services(dnssd);
+    dnssd->registration_generation = generation;
+    dnssd->raop_context.generation = generation;
+    dnssd->airplay_context.generation = generation;
+    dnssd->registration_error = 0;
+
+    /* /info remains valid even if the first DNSServiceRegister call fails
+     * synchronously: prepare both lifetime TXT records before either service
+     * ref is attempted. */
+    int error = dnssd_prepare_raop_txt(dnssd);
+    if (!error) error = dnssd_prepare_airplay_txt(dnssd);
+    if (error) {
+        dnssd->registration_error = error;
+        return error;
+    }
+
+    error = dnssd_register_raop(dnssd, raop_port);
+    if (error) {
+        dnssd_unregister_services(dnssd);
+        dnssd->registration_error = error;
+        return error;
+    }
+
+    error = dnssd_register_airplay(dnssd, airplay_port);
+    if (error) {
+        dnssd_unregister_services(dnssd);
+        dnssd->registration_error = error;
+        return error;
+    }
+    return 0;
+}
