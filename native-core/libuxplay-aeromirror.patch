+static void DNSSD_STDCALL
+dnssd_register_reply(DNSServiceRef sdRef, DNSServiceFlags flags,
+                     DNSServiceErrorType errorCode, const char *name,
+                     const char *regtype, const char *domain, void *context)
+{
+    (void) name;
+    (void) regtype;
+    (void) domain;
+
+    if (!context) return;
+    dnssd_registration_context_t *registration = context;
+    dnssd_t *dnssd = registration->owner;
+    if (!dnssd || registration->generation != dnssd->registration_generation) {
+        return;
+    }
+
+    int *state = registration->service_kind == DNSSD_SERVICE_RAOP
+        ? &dnssd->raop_registration_state
+        : &dnssd->airplay_registration_state;
+    DNSServiceRef expected = registration->service_kind == DNSSD_SERVICE_RAOP
+        ? dnssd->raop_service
+        : dnssd->airplay_service;
+    if (expected != sdRef || *state == DNSSD_REGISTRATION_FAILED) return;
+
+    if (errorCode == 0 && (flags & DNSSD_FLAGS_ADD)) {
+        *state = DNSSD_REGISTRATION_READY;
+    } else {
+        *state = DNSSD_REGISTRATION_FAILED;
+        dnssd->registration_error = errorCode
+            ? (int) errorCode
+            : -65569;
+    }
+}
