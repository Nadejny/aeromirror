diff --git a/renderers/video_renderer.c b/renderers/video_renderer.c
index ea1c450..b3c4b2f 100644
--- a/renderers/video_renderer.c
+++ b/renderers/video_renderer.c
@@ -81,6 +81,7 @@ struct video_renderer_s {
     GstBus *bus;
     const char *codec;
     bool autovideo;
+    bool aeromirror_selection_logged;
     int id;
     char *uri;
     gboolean eos;
@@ -101,6 +102,68 @@ static char h265[] = "h265";
 static char hls[]  = "hls";
 static char jpeg[] = "jpeg";
 
+static void aeromirror_log_pipeline_selection(video_renderer_t *selected) {
+    if (!selected || selected->aeromirror_selection_logged || hls_video ||
+        !strcmp(selected->codec, jpeg)) {
+        return;
+    }
+
+    char decoder_name[64] = { 0 };
+    char videosink_name[64] = { 0 };
+    GstIterator *iterator = gst_bin_iterate_recurse(GST_BIN(selected->pipeline));
+    GValue item = G_VALUE_INIT;
+    gboolean done = FALSE;
+
+    while (!done) {
+        switch (gst_iterator_next(iterator, &item)) {
+        case GST_ITERATOR_OK: {
+            GstElement *element = GST_ELEMENT(g_value_get_object(&item));
+            GstElementFactory *factory = gst_element_get_factory(element);
+            if (factory) {
+                const gchar *factory_name = gst_plugin_feature_get_name(
+                    GST_PLUGIN_FEATURE(factory));
+                const gchar *klass = gst_element_factory_get_metadata(
+                    factory, GST_ELEMENT_METADATA_KLASS);
+                if (factory_name && klass) {
+                    if (!decoder_name[0] && strstr(klass, "Decoder") &&
+                        strstr(klass, "Video") &&
+                        strcmp(factory_name, "decodebin")) {
+                        g_strlcpy(decoder_name, factory_name, sizeof(decoder_name));
+                    }
+                    if (!videosink_name[0] && strstr(klass, "Sink") &&
+                        strstr(klass, "Video") &&
+                        strcmp(factory_name, "autovideosink")) {
+                        g_strlcpy(videosink_name, factory_name, sizeof(videosink_name));
+                    }
+                }
+            }
+            g_value_reset(&item);
+            break;
+        }
+        case GST_ITERATOR_RESYNC:
+            gst_iterator_resync(iterator);
+            decoder_name[0] = '\0';
+            videosink_name[0] = '\0';
+            break;
+        case GST_ITERATOR_ERROR:
+        case GST_ITERATOR_DONE:
+            done = TRUE;
+            break;
+        }
+    }
+    if (G_VALUE_TYPE(&item)) {
+        g_value_unset(&item);
+    }
+    gst_iterator_free(iterator);
+
+    if (decoder_name[0] && videosink_name[0]) {
+        logger_log(logger, LOGGER_INFO,
+                   "AEROMIRROR_GSTREAMER_SELECTED codec=%s decoder=%s videosink=%s",
+                   selected->codec, decoder_name, videosink_name);
+        selected->aeromirror_selection_logged = true;
+    }
+}
+
 static void append_videoflip (GString *launch, const videoflip_t *flip, const videoflip_t *rot) {
     /* videoflip image transform */
     switch (*flip) {
@@ -177,6 +240,9 @@ void video_renderer_size(float *f_width_source, float *f_height_source, float *f
     height_source = (unsigned short) *f_height_source;
     width = (unsigned short) *f_width;
     height = (unsigned short) *f_height;
+    logger_log(logger, LOGGER_INFO,
+               "AEROMIRROR_VIDEO_SIZE source=%dx%d encoded=%dx%d",
+               width_source, height_source, width, height);
     logger_log(logger, LOGGER_DEBUG, "begin video stream wxh = %dx%d; source %dx%d", width, height, width_source, height_source);
 }
 
@@ -812,7 +878,9 @@ static gboolean gstreamer_video_pipeline_bus_callback(GstBus *bus, GstMessage *m
         return TRUE;
     }
 
+    video_renderer_t *active_renderer = renderer;
     video_renderer_t *renderer = renderer_type[type];
+    bool aeromirror_selected_renderer = (renderer == active_renderer);
 
     gint64 pos = -1;
     if (hls_video) {
@@ -1009,6 +1077,9 @@ static gboolean gstreamer_video_pipeline_bus_callback(GstBus *bus, GstMessage *m
       /* unhandled message */
         break;
     }
+    if (aeromirror_selected_renderer) {
+        aeromirror_log_pipeline_selection(renderer);
+    }
     return TRUE;
 }
 
