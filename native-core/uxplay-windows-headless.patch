+void MainWindow::emitBluetoothBeaconLine(const QByteArray &line) {
+    QByteArray clean = line;
+    while (!clean.isEmpty() &&
+           (clean.endsWith('\r') || clean.endsWith('\n'))) {
+        clean.chop(1);
+    }
+    if (clean.isEmpty()) return;
+    QByteArray framed("AEROMIRROR_BLE ");
+    framed.append(clean);
+    framed.append('\n');
+    fwrite(framed.constData(), 1,
+           static_cast<size_t>(framed.size()), stderr);
+    fflush(stderr);
+}
+
+void MainWindow::reportBluetoothBeaconFailure(const QByteArray &detail) {
+    if (m_beaconStopping || m_beaconFailureReported) return;
+    m_beaconFailureReported = true;
+
+    QByteArray bounded = detail;
+    bounded.replace('\r', ' ');
+    bounded.replace('\n', ' ');
+    static constexpr qsizetype maximumDetailBytes = 512;
+    if (bounded.size() > maximumDetailBytes) {
+        bounded.truncate(maximumDetailBytes);
+        bounded.append("...");
+    }
+    if (bounded.isEmpty()) bounded = "unspecified helper error";
+    emitBluetoothBeaconLine(
+        QByteArray("Advertising failed: ") + bounded);
+}
+
+void MainWindow::consumeBluetoothBeaconOutput(bool flushResidual) {
+    if (m_beacon) m_beaconOutputBuffer.append(m_beacon->readAll());
+    static constexpr qsizetype maximumBufferedBytes = 64 * 1024;
+    if (m_beaconOutputBuffer.size() > maximumBufferedBytes) {
+        emitBluetoothBeaconLine(
+            QByteArray("output overflow; dropping unterminated helper data"));
+        m_beaconOutputBuffer.clear();
+        return;
+    }
+    while (true) {
+        qsizetype cr = m_beaconOutputBuffer.indexOf('\r');
+        qsizetype lf = m_beaconOutputBuffer.indexOf('\n');
+        qsizetype end = cr < 0 ? lf : (lf < 0 ? cr : std::min(cr, lf));
+        if (end < 0) break;
+        QByteArray line = m_beaconOutputBuffer.left(end);
+        qsizetype remove = end + 1;
+        if (remove < m_beaconOutputBuffer.size() &&
+            ((m_beaconOutputBuffer.at(end) == '\r' &&
+              m_beaconOutputBuffer.at(remove) == '\n') ||
+             (m_beaconOutputBuffer.at(end) == '\n' &&
+              m_beaconOutputBuffer.at(remove) == '\r'))) {
+            ++remove;
+        }
+        m_beaconOutputBuffer.remove(0, remove);
+        emitBluetoothBeaconLine(line);
+    }
+    if (flushResidual && !m_beaconOutputBuffer.isEmpty()) {
+        emitBluetoothBeaconLine(m_beaconOutputBuffer);
+        m_beaconOutputBuffer.clear();
+    }
 }
 
