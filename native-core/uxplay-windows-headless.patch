+    if (parts.size() != 4) {
+        return false;
+    }
+    for (const QString &part : parts) {
+        bool ok = false;
+        const int octet = part.toInt(&ok, 10);
+        if (!ok || part.isEmpty() || octet < 0 || octet > 255) {
+            return false;
+        }
+    }
+    return true;
+}
